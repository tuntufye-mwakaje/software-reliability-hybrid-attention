{
  "experiment": "multi_dataset_hybrid_attention",
  "seed": 42,
  "datasets": [
    "CM1",
    "JM1",
    "KC1",
    "KC2",
    "PC1"
  ],
  "batch_size": 32,
  "epochs": 50,
  "learning_rate": 0.001,
  "weight_decay": 0.0001,
  "early_stopping_patience": 10,
  "lr_reduction_patience": 5,
  "lr_reduction_factor": 0.5,
  "gradient_clip_norm": 1.0,
  "embedding_dim": 32,
  "num_heads": 4,
  "dropout": 0.1,
  "device": "cpu",
  "parameter_count": 9985,
  "threshold": 0.5,
  "split_protocol": "frozen_grouped_feature_split_seed42",
  "scaling_protocol": "fit_train_only",
  "model_selection": "minimum_validation_loss",
  "test_usage": "final_evaluation_only"
}